# =============================================================================
# Pipe-LeadFinder — env layout aligned with ClickCampaigns-ai
# Copy to .env and fill in values. Never commit .env
# =============================================================================

# Session / NextAuth (generate: openssl rand -base64 32)
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32
AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32
AUTH_URL=http://localhost:3000

# Neon → DigitalOcean one-time copy (see scripts/migrate-postgres-to-do.sh; needs SOURCE_DATABASE_URL from Neon console)

# DigitalOcean Managed PostgreSQL
DATABASE_URL=postgresql://doadmin:REPLACE_PASSWORD@REPLACE_HOST.db.ondigitalocean.com:25061/REPLACE_DATABASE?sslmode=require
PGDATABASE=REPLACE_DATABASE
PGHOST=REPLACE_HOST.db.ondigitalocean.com
PGPORT=25061
PGUSER=doadmin
PGPASSWORD=REPLACE_PASSWORD

# Replicate (optional)
REPLICATE_API_KEY=r8_REPLACE_ME

# Keycloak / OIDC — used by both client (keycloak-js) and server (jose JWKS)
# NEXT_PUBLIC_ prefix exposes these to the browser (required for keycloak-js)
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.groovetech.io/auth
NEXT_PUBLIC_KEYCLOAK_REALM=gd-apis-live
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=app-pipefinder
# Required Keycloak app role (users without this role are blocked)
# NEXT_PUBLIC_KEYCLOAK_REQUIRED_ROLE=app_pipefinder

# App hosting
BASE_URL=http://localhost:3000
NODE_ENV=development
DEV_AUTO_LOGIN=true
PORT=3000

# AI — OpenRouter (same setup as ClickCampaigns). Every AI feature (assistant,
# Agent, lead scoring, "Describe who you want") uses DeepSeek V4.1 Flash with
# the DeepSeek V4 Flash 0731 fallback. OPENROUTER_API_KEY is also accepted.
OPEN_ROUTER_API_KEY=sk-or-REPLACE_ME
# Optional: override the primary model. It must have a row in the ScaleCredits
# pricing table or token billing will fail.
# LEADFINDER_AI_MODEL=deepseek/deepseek-v4.1-flash
# Optional: HTTP-Referer sent to OpenRouter (defaults to BASE_URL).
# OPENROUTER_HTTP_REFERER=https://leadfinder.pipeleads.ai

# Pexels
PEXELS_API_KEY=REPLACE_PEXELS_KEY

# Fal.ai (optional)
FAL_AI_API_KEY=REPLACE_UUID:REPLACE_SECRET

# DigitalOcean Spaces (S3-compatible object storage)
DO_SPACES_KEY=REPLACE_DO_SPACES_KEY
DO_SPACES_SECRET=REPLACE_DO_SPACES_SECRET
DO_SPACES_BUCKET=scaleplus
DO_SPACES_REGION=nyc3
MAX_AI_TOKENS=60000

# Firecrawl
FIRECRAWL_API_KEY=fc-REPLACE_ME

# ScaleCredits microservice
MICRO_SERVICE_BASE=http://localhost:3002/api
INTERNAL_WEBHOOK_SECRET=
SCALECREDITS_URL=https://credits.scaleplus.gg
NEXT_PUBLIC_SCALECREDITS_URL=https://credits.scaleplus.gg
# Where the sidebar's PipeLeads CRM and ProjectBaser links point (same tab)
NEXT_PUBLIC_PIPELEADS_SUITE_URL=https://go.pipeleads.ai
SCALECREDITS_APP_NAME=PipeLeads

# AI Agent scheduler (used by npm run agents:scheduled / cron)
PIPELEADS_AGENT_CRON_SECRET=replace-with-long-random-secret

# Focused Pro Max Agent and Superpowers (independent rollout; all default off)
# Requires an existing verified Keycloak user, destination-app access, current
# ClickCampaigns entitlement, configured Scale Credits, and the additive migration.
LEADFINDER_AGENT_ENABLED=false
LEADFINDER_GODMODE_ENABLED=false
LEADFINDER_AGENT_WRITES_ENABLED=false
LEADFINDER_AGENT_HANDOFF_ENABLED=false
# Development only (ignored unless NODE_ENV=development): act as a Pro Max user
# ("promax") or a user without it ("none") without ClickCampaigns or ScaleCredits.
# LEADFINDER_AGENT_DEV_BYPASS=promax
# Where the non-Pro Max upsell links (default https://scale.gg/pricing/)
# NEXT_PUBLIC_PROMAX_UPGRADE_URL=
CLICKCAMPAIGNS_GODMODE_BASE_URL=https://clickcampaigns.ai
# Distinct per-app random secret (at least 32 bytes), shared only with the bridge.
LEADFINDER_GODMODE_SERVICE_SECRET=

# Durable jobs and outbound integrations
PIPELEADS_JOBS_ENABLED=true
# Separate random secret recommended; AUTH_SECRET is used as a fallback.
INTEGRATION_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Apify
APIFY_API_KEY=apify_api_REPLACE_ME
# Optional: the separate Apify account (organization) that runs phone and email
# lookups. Their finders ask for full account access, so they get their own.
APIFY_ENRICH_API_KEY=

# Apify Actor IDs (configure per search type)
APIFY_ACTOR_PEOPLE=harvestapi/linkedin-profile-search
APIFY_ACTOR_LOCAL=agents/google-maps-search
APIFY_ACTOR_COMPANY=apimaestro/linkedin-companies-search-scraper
APIFY_ACTOR_DOMAIN=george.the.developer/company-enrichment-api
# Influencer discovery is routed per platform. The legacy all-platform actor is
# retained only for backwards-compatible configuration and is no longer called.
APIFY_ACTOR_INFLUENCER=alizarin_refrigerator-owner/influencer-discovery---find-influencers-across-social-platforms
APIFY_ACTOR_INFLUENCER_INSTAGRAM=apify/instagram-search-scraper
APIFY_ACTOR_INFLUENCER_TIKTOK=coregent/tiktok-influencer-finder
APIFY_ACTOR_YOUTUBE=streamers/youtube-scraper
APIFY_ACTOR_ENRICH_EMAIL=code_crafter/personal-email-finder
APIFY_ACTOR_ENRICH_PHONE=code_crafter/mobile-finder

# Signed saved-prospect automations. Apply additive SQL before enabling.
# This adapter does not search, enrich, send messages, or spend credits.
SCALEPLUS_AUTOMATIONS_ENABLED=false
SCALEPLUS_AUTOMATION_SERVICE_SECRET=
PIPELEADSFINDER_AUTOMATION_WEBHOOK_SECRET=
PIPELEADSFINDER_AUTOMATION_WEBHOOK_URL=https://mailbaser.com/api/webhooks/automations/pipeleadsfinder

# Scale Plus Team Workspaces (Pro Max) — DISABLED BY DEFAULT.
# Do not enable until this app passes the central certification matrix and the
# manual SQL in prisma/manual-migrations/ has been approved and applied.
SCALE_TEAM_WORKSPACES_ENABLED=false
NEXT_PUBLIC_SCALE_TEAM_WORKSPACES_ENABLED=false
# Keep owner-billed searches, enrichment, and scoring unavailable to guests
# unless the owner-attributed usage policy has separately been approved.
SCALE_TEAM_WORKSPACES_OWNER_USAGE_ENABLED=false
# Central workspace hub + app credentials (values issued by the ScalePlus hub;
# names only here — never commit real values).
SCALE_WORKSPACE_HUB_URL=
SCALE_WORKSPACE_CLIENT_ID=
SCALE_WORKSPACE_CLIENT_SECRET=

# One-click "Add to PipeLeads" and "Add to MailBaser" (docs/HANDOFF-SUITE-MAILBASER.md).
# Each target is enabled only when its URL is set AND its secret is at least 32
# characters; otherwise its buttons are hidden and its routes answer 404.
# Each secret is shared with exactly one receiver (openssl rand -hex 32).
# PipeLeads Suite (CRM), e.g. https://go.pipeleads.ai
PIPELEADS_SUITE_URL=
LEADFINDER_SUITE_SERVICE_SECRET=
# MailBaser, e.g. https://mailbaser.com
MAILBASER_URL=
LEADFINDER_MAILBASER_SERVICE_SECRET=
