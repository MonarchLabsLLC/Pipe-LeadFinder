generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────
// Private assistant records, never attendee chat. Actor + workspace scope is mandatory.
model FocusedAgentThread {
  id          String @id @default(uuid())
  userId      String
  workspaceId String
  origin      String @default("native")
  title       String @default("New conversation")
  resourceIds Json @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    FocusedAgentMessage[]
  runs        FocusedAgentRun[]
  approvals   FocusedAgentApproval[]
  @@index([userId, workspaceId, updatedAt])
}

model FocusedAgentMessage {
  id        String @id @default(uuid())
  threadId  String
  thread    FocusedAgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  metadata  Json @default("{}")
  createdAt DateTime @default(now())
  @@index([threadId, createdAt])
}

model FocusedAgentRun {
  id             String @id @default(uuid())
  userId         String
  workspaceId    String
  subject        String
  threadId       String
  thread         FocusedAgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  origin         String
  kind           String @default("chat")
  status         String @default("queued")
  activeKey      String? @unique
  input          Json
  inputHash      String
  result         Json?
  error          String?
  idempotencyKey String
  heartbeatAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  usage          FocusedAgentUsage[]
  @@unique([userId, workspaceId, idempotencyKey])
  @@index([status, createdAt])
}

model FocusedAgentApproval {
  id             String @id @default(uuid())
  userId         String
  workspaceId    String
  subject        String
  origin         String
  threadId       String?
  thread         FocusedAgentThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  action         String
  input          Json
  preview        Json
  versions       Json
  proposalHash   String
  status         String @default("pending")
  expiresAt      DateTime
  approvedAt     DateTime?
  approvalMethod String?
  result         Json?
  idempotencyKey String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([userId, workspaceId, idempotencyKey])
  @@index([userId, workspaceId, status])
}

model FocusedAgentNonce {
  issuer    String
  nonce     String
  subject   String
  expiresAt DateTime
  @@id([issuer, nonce])
  @@index([expiresAt])
}

model FocusedAgentContext {
  userId      String
  workspaceId String
  resourceIds Json @default("[]")
  expiresAt   DateTime
  @@id([userId, workspaceId])
}

model FocusedAgentAudit {
  id          String @id @default(uuid())
  userId      String
  workspaceId String
  action      String
  outcome     String
  metadata    Json @default("{}")
  createdAt   DateTime @default(now())
  @@index([userId, workspaceId, createdAt])
}

model FocusedAgentUsage {
  id           String @id @default(uuid())
  runId        String
  run          FocusedAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId       String
  subject      String
  model        String
  inputTokens  Int
  outputTokens Int
  requestId    String @unique
  state        String @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


enum SearchType {
  PEOPLE
  LOCAL
  COMPANY
  DOMAIN
  INFLUENCER
}

enum ListStatus {
  ACTIVE
  ARCHIVED
}

enum EmailStatus {
  UNKNOWN
  FOUND
  NOT_FOUND
  POTENTIAL
}

enum PhoneStatus {
  UNKNOWN
  FOUND
  NOT_FOUND
}

enum SearchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AiActionType {
  SIMILAR_PEOPLE
  DIRECT_MESSAGE
  SUMMARY
  SUBJECT_LINE
  INTRO
  CUSTOM
  LIBRARY
}

enum DataSourceType {
  WEBSITE
  TEXT
  QA
  PDF
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum LeadIdentityType {
  EMAIL
  LINKEDIN
  SOCIAL_USERNAME
  COMPANY_DOMAIN
}

enum JobKind {
  SEARCH
  AGENT_RUN
  BULK_ENRICH_EMAIL
  BULK_ENRICH_PHONE
  BULK_SCORE
  INTEGRATION_DELIVERY
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum IntegrationType {
  GENERIC_WEBHOOK
}

enum DeliveryStatus {
  PENDING
  DELIVERING
  DELIVERED
  FAILED
}

// ─── Models ──────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  role          String   @default("user")
  keycloakSubId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lists           LeadList[]
  labels          CustomLabel[]
  agents          AiAgent[]
  leads           Lead[]
  leadIdentities  LeadIdentity[]
  jobs            JobRun[]
  integrations    IntegrationConnection[]
  businessProfile BusinessProfile?
  searches        SearchHistory[]
}

model LeadList {
  id        String     @id @default(cuid())
  name      String
  type      SearchType
  status    ListStatus @default(ACTIVE)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  leads    LeadListEntry[]
  searches SearchHistory[]
  jobs     JobRun[]

  @@index([userId])
  @@index([status])
}

model Lead {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity
  firstName String?
  lastName  String?
  fullName  String?
  title     String?
  headline  String?
  avatarUrl String?

  // Location
  city     String?
  state    String?
  country  String?
  location String?

  // Contact
  email       String?
  emailStatus EmailStatus @default(UNKNOWN)
  phone       String?
  phoneStatus PhoneStatus @default(UNKNOWN)

  // Social
  linkedinUrl  String?
  facebookUrl  String?
  twitterUrl   String?
  instagramUrl String?
  tiktokUrl    String?
  youtubeUrl   String?

  // Company
  companyName     String?
  companyWebsite  String?
  companyLinkedin String?
  companySize     String?
  companyRevenue  String?
  companyIndustry String?

  // Influencer-specific
  platform       String?
  username       String?
  followerCount  Int?
  engagementRate Float?
  bio            String?

  // Meta
  sourceType SearchType
  rawData    Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  listEntries LeadListEntry[]
  aiResults   AiResult[]
  identities  LeadIdentity[]

  @@index([userId])
  @@index([email])
  @@index([sourceType])
}

model LeadIdentity {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadIdentityType
  value     String
  createdAt DateTime         @default(now())

  @@unique([userId, type, value])
  @@index([leadId])
}

model LeadListEntry {
  id        String   @id @default(cuid())
  listId    String
  list      LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  labels LeadEntryLabel[]

  @@unique([listId, leadId])
  @@index([listId])
  @@index([leadId])
}

model CustomLabel {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  entries LeadEntryLabel[]

  @@unique([userId, name])
  @@index([userId])
}

model LeadEntryLabel {
  id        String        @id @default(cuid())
  entryId   String
  entry     LeadListEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  labelId   String
  label     CustomLabel   @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([entryId, labelId])
}

model SearchHistory {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  listId      String?
  list        LeadList?    @relation(fields: [listId], references: [id], onDelete: SetNull)
  searchType  SearchType
  parameters  Json
  resultCount Int          @default(0)
  status      SearchStatus @default(PENDING)
  apifyRunId  String?
  createdAt   DateTime     @default(now())
  job         JobRun?

  @@index([userId])
  @@index([listId, createdAt])
  @@index([status])
}

model AiResult {
  id         String       @id @default(cuid())
  leadId     String
  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actionType AiActionType
  prompt     String?
  result     String       @db.Text
  model      String?
  createdAt  DateTime     @default(now())

  @@index([leadId])
}

model BusinessProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  businessName    String?
  businessWebsite String?
  whatYouSell     String?
  whoItHelps      String?
  whatItDoes      String?
  contactPerson   String?
  personality     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dataSources DataSource[]
}

model DataSource {
  id           String          @id @default(cuid())
  profileId    String
  profile      BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fileUploadId String?         @unique
  fileUpload   FileUpload?     @relation(fields: [fileUploadId], references: [id], onDelete: SetNull)
  type         DataSourceType
  content      String          @db.Text
  sourceUrl    String?
  name         String?
  createdAt    DateTime        @default(now())

  @@index([profileId])
}

model AiAgent {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  name            String
  description     String?
  status          AgentStatus @default(DRAFT)
  config          Json?
  autoSave        Boolean     @default(false)
  schedulerLockAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  jobs            JobRun[]

  @@index([userId])
  @@index([status])
}

model JobRun {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            JobKind
  status          JobStatus             @default(QUEUED)
  idempotencyKey  String
  queueJobId      String?               @unique
  stage           String?
  progressCurrent Int                   @default(0)
  progressTotal   Int                   @default(0)
  payload         Json?
  result          Json?
  errorCode       String?
  errorMessage    String?
  listId          String?
  list            LeadList?             @relation(fields: [listId], references: [id], onDelete: SetNull)
  searchId        String?               @unique
  search          SearchHistory?        @relation(fields: [searchId], references: [id], onDelete: SetNull)
  agentId         String?
  agent           AiAgent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  providerRunId   String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  items           JobItem[]
  deliveries      IntegrationDelivery[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([kind, status])
  @@index([listId])
  @@index([agentId])
}

model JobItem {
  id            String    @id @default(cuid())
  jobRunId      String
  jobRun        JobRun    @relation(fields: [jobRunId], references: [id], onDelete: Cascade)
  subjectType   String
  subjectId     String
  action        String
  status        JobStatus @default(QUEUED)
  providerRunId String?
  result        Json?
  errorMessage  String?
  billedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([jobRunId, subjectType, subjectId, action])
  @@index([jobRunId, status])
}

model IntegrationConnection {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  type             IntegrationType       @default(GENERIC_WEBHOOK)
  url              String
  secretCiphertext String
  secretIv         String
  secretTag        String
  enabled          Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deliveries       IntegrationDelivery[]

  @@unique([userId, name])
  @@index([userId, enabled])
}

model IntegrationDelivery {
  id             String                @id @default(cuid())
  deliveryId     String                @unique
  connectionId   String
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  jobRunId       String?
  jobRun         JobRun?               @relation(fields: [jobRunId], references: [id], onDelete: SetNull)
  status         DeliveryStatus        @default(PENDING)
  attemptCount   Int                   @default(0)
  responseStatus Int?
  errorMessage   String?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([connectionId, createdAt])
  @@index([jobRunId])
  @@index([status])
}

model PromptTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  prompt    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model FileUpload {
  id          String   @id @default(cuid())
  userId      String
  storageKey  String   @unique
  filename    String
  contentType String
  size        Int
  folder      String
  url         String
  createdAt   DateTime @default(now())

  dataSource DataSource?

  @@index([userId])
  @@index([userId, folder])
}
